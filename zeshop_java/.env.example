# Production Java service settings
SHOP_JAVA_PORT=8080
SHOP_STORE_ID=demo-store
SHOP_CORS_ORIGINS=https://shop.example.com
SHOP_JAVA_DATABASE_URL=jdbc:postgresql://127.0.0.1:5433/shop_mvp
SHOP_JAVA_DATABASE_USER=shop_admin
SHOP_JAVA_DATABASE_PASSWORD=replace-with-database-password
SHOP_AUTH_SECRET=replace-with-a-long-random-secret
SHOP_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
SHOP_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-password
SHOP_SEED_DEMO=false
MAIN_MODEL_BASE_URL=https://main-provider.example/v1
MAIN_MODEL_API_KEY=replace-with-provider-key
MAIN_MODEL=main-model
EMBEDDING_MODEL=text-embedding-3-small
JEV_BASE_URL=https://jev-provider.example/v1
JEV_API_KEY=replace-with-jev-key
JEV_MODEL=jev-fast
